generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncEventStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum LocalOrderState {
  DRAFT
  VALIDATING
  POS_SUBMITTING
  CONFIRMED
  REJECTED
  SYNC_UNKNOWN
}

enum ProductContentStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

/// ADR 0007 — Merchant apparel facts.
///
/// These are the reviewed Google Merchant controlled values, held as database enums so an
/// out-of-allowlist value cannot be persisted at all. The application layer still validates every
/// admin submission and every value it reads back: the database constraint is defence in depth, not
/// the only gate.
enum MerchantGender {
  MALE
  FEMALE
  UNISEX
}

enum MerchantAgeGroup {
  NEWBORN
  INFANT
  TODDLER
  KIDS
  ADULT
}

enum MerchantCondition {
  NEW
  REFURBISHED
  USED
}

enum PromotionCampaignKind {
  PROMOTION
  FLASH_SALE
  /// "Xả hàng lẻ size": priced like PROMOTION, listed on /sale/xa-hang-le-size.
  CLEARANCE
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_PRICE
}

/// Gift & Quantity Promotions v1 (ADR 0016). Deliberately separate from `PromotionCampaignKind` /
/// `PromotionDiscountType`: legacy readers never see these rows, so a new rule can never be priced
/// by the legacy resolver and the legacy enums keep their exact meaning.
enum GiftQuantityCampaignKind {
  GIFT_ITEM
  QUANTITY_TIER
}

enum GiftQuantityScopeMode {
  /// Only for GIFT_ITEM + ORDER_SUBTOTAL + ALL_PAID_LINES: every paid line, no targets.
  GLOBAL_ALL_PAID_LINES
  /// Category membership is read when the benefit is evaluated.
  DYNAMIC_CATEGORY
  /// Product ids frozen in the publish transaction (`GiftQuantityFrozenProduct`).
  FIXED_PRODUCT_SET
}

enum GiftTrigger {
  QUANTITY
  ORDER_SUBTOTAL
}

enum GiftSubtotalScope {
  ALL_PAID_LINES
  ELIGIBLE_PAID_LINES
}

enum GiftAwardMode {
  ONCE
  REPEAT_PER_THRESHOLD
}

enum QuantityTierDiscountUnit {
  PERCENTAGE
  /// VND taken off each discounted unit. Never a total, never a fixed sale price.
  FIXED_AMOUNT_PER_UNIT_VND
}

enum QuantityTierDiscountedUnits {
  ALL_ELIGIBLE_UNITS
  FROM_REACHED_THRESHOLD
}

enum QuantityTierSelectionPriority {
  CHEAPEST_FIRST
  MOST_EXPENSIVE_FIRST
}

enum GiftQuantityScopeTargetRole {
  INCLUDE
  EXCLUDE
}

/// Which side of a stack pairing a peer names. A pairing is only effective when both campaigns
/// allow each other (ADR 0016 D-01); the two-way check is the lifecycle service's job.
enum GiftQuantityStackPeerKind {
  PROMOTION
  FLASH_SALE
  CLEARANCE
  QUANTITY_TIER
  GIFT_ITEM
}

/// ADR 0014 §5. Website-owned; Pancake catalog sync never writes it (master spec §27).
enum SellingMode {
  STANDARD
  OVERSELL
  PREORDER
}

/// ADR 0014 §4. Deliberately parallel to `LocalOrderState` rather than a competing vocabulary:
/// `SUBMITTING` ↔ `POS_SUBMITTING`, `UNKNOWN` ↔ `SYNC_UNKNOWN`, `COMMITTED` ↔ `CONFIRMED`.
enum ReservationState {
  RESERVED
  SUBMITTING
  COMMITTED
  RELEASED
  UNKNOWN
}

enum OrderPreorderLineState {
  READY
  PREORDER
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String?
  role          UserRole      @default(CUSTOMER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  carts         Cart[]
  orders        OrderMirror[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                   String?
  password                String?
  createdAt               DateTime
  updatedAt               DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt DateTime?
  updatedAt DateTime?

  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  provinceRef   String
  districtRef   String
  communeRef    String
  detail        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductMirror {
  id                String               @id @default(cuid())
  pancakeShopId     Int                  @default(0)
  pancakeProductId  String               @unique
  slug              String               @unique
  /// Pancake product name without its trailing product code ("Set váy Diệu Liên Hoa").
  name              String
  /// The trailing product code split off the Pancake name ("SV605"), kept for search.
  productCode       String?
  sourceDescription String?
  primaryImageUrl   String?
  isPresent         Boolean              @default(true)
  isActive          Boolean              @default(true)
  syncedAt          DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  variants          VariantMirror[]
  content           ProductContent?
  merchantFacts     ProductMerchantFacts?
  slugHistory       ProductSlugHistory[]
  promotionTargets  PromotionTarget[]
  giftQuantityTargets         GiftQuantityTarget[]
  giftQuantityFrozenProducts  GiftQuantityFrozenProduct[]

  homepageFeature      HomepageFeaturedProduct?
  newArrival           NewArrivalProduct?
  categoryMemberships  ProductCategoryMembership[]
  categoryOrders       CategoryProductOrder[]
  relatedOverrides     RelatedProductOverride[]    @relation("RelatedSource")
  relatedOverrideOf    RelatedProductOverride[]    @relation("RelatedTarget")
  sellingPolicy        ProductSellingPolicy?

  @@index([pancakeShopId, isPresent])
}

/// Admin-selected products for /new-arrivals. No date-based membership or auto-expiry.
model NewArrivalProduct {
  productId     String @id
  pancakeShopId Int
  position      Int

  product ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pancakeShopId, position])
}

model ProductSlugHistory {
  slug      String        @id
  productId String
  createdAt DateTime      @default(now())
  product   ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductContent {
  id                   String               @id @default(cuid())
  productId            String               @unique
  status               ProductContentStatus @default(DRAFT)
  editorialDescription String?
  /** Fabric composition as one editorial sentence, e.g. "100% cotton dệt kim". */
  material             String?
  /** Construction notes, one per entry, rendered as a list rather than a paragraph. */
  craftDetails         String[]             @default([])
  careInstructions     String?
  sizeGuide             String?
  seoTitle              String?
  seoDescription        String?
  collectionSlugs      String[]             @default([])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  product               ProductMirror        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// ADR 0007 — website-owned Merchant apparel overrides for one product.
///
/// Absence is inheritance, never "unknown": a null column means this product uses the approved shop
/// default for that fact, and clearing an override in admin removes the value rather than copying
/// the current default into the row. The three facts are independent, so a product may override one
/// and inherit the other two.
///
/// This table is website-owned. Pancake catalog sync never writes, clears or derives it — that is
/// what keeps a resync from silently erasing a merchandising decision. It is deliberately separate
/// from `ProductContent` so that an editorial publication state cannot gate a Merchant fact, and
/// separate from the Pancake mirror columns so that ownership is visible in the schema itself.
model ProductMerchantFacts {
  id        String             @id @default(cuid())
  productId String             @unique
  gender    MerchantGender?
  ageGroup  MerchantAgeGroup?
  condition MerchantCondition?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   ProductMirror      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CollectionDefinition {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String?
  seoTitle           String?
  seoDescription     String?
  /** Editorial media. `description` is the collection's story; there is no separate story field. */
  heroImageUrl       String?
  heroImageMobileUrl String?
  galleryImageUrls   String[] @default([])
  videoSrcUrl        String?
  videoPosterUrl     String?
  /** Slugs the merchandiser pinned to the top of the grid, in the order they should appear. */
  featuredProductSlugs String[] @default([])
  isPublished        Boolean  @default(false)
  homepagePosition   Int?     @unique
  pancakeCategoryIds Int[]    @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One shared rule across all of a campaign's targets.
///
/// Admin-visible status (Draft / Scheduled / Active / Ended / Disabled) is derived, never stored:
/// `isEnabled`, `enabledAt`, `disabledAt` and the configured window are enough to decide whether an
/// enabled interval ever overlapped an active one. Persisting a status — or an "ever active" flag
/// written when a request happens to observe the campaign — would be wrong after a restart or for a
/// window that opened and closed with zero traffic.
///
/// Website-owned money is integer VND: an integer percentage, or a `BigInt` final unit price. The
/// mirrored Pancake `Float?` columns stay external facts and are not converted here.
model PromotionCampaign {
  id              String                @id @default(cuid())
  kind            PromotionCampaignKind
  name            String
  discountType    PromotionDiscountType
  percentageValue Int?
  fixedPriceVnd   BigInt?
  startsAt        DateTime?
  endsAt          DateTime?
  isEnabled       Boolean               @default(false)
  enabledAt       DateTime?
  disabledAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  targets         PromotionTarget[]
  /// Consent to stack with quantity-tier campaigns (ADR 0016 D-10). A relation only: no column is
  /// added to this legacy table, and a campaign without a row keeps today's behaviour exactly.
  stackConsent    LegacyPromotionStackConsent?

  @@index([isEnabled, startsAt, endsAt])
}

/// Exactly one of `productId` / `variantId` is populated, enforced by a database check rather than
/// by the admin UI. A PRODUCT row is a semantic scope over the product's current variants — it is
/// deliberately not materialized into a frozen variant list, so variants synced or restored later
/// are covered without a rewrite.
model PromotionTarget {
  id         String            @id @default(cuid())
  campaignId String
  productId  String?
  variantId  String?
  createdAt  DateTime          @default(now())
  campaign   PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    ProductMirror?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    VariantMirror?    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@unique([campaignId, variantId])
  @@index([productId])
  @@index([variantId])
}

/// One durable, server-owned, monotonic revision of effective promotion pricing.
///
/// A single row by construction: bounded cardinality is the point, so a Merchant cache decision can
/// read the current generation cheaply and a promotion mutation can advance it inside the same
/// transaction that commits the mutation. Nothing request-controlled reaches it, and it never grows
/// per campaign or per request.
model PromotionPricingRevision {
  id        String   @id @default("current")
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

/// One gift or quantity-tier campaign (Gift & Quantity Promotions v1).
///
/// Lifecycle fields mean exactly what they mean on `PromotionCampaign` and feed the same derived
/// status (Draft / Scheduled / Active / Ended / Disabled): status is never stored.
///
/// What the database enforces is what is universal at rest: enum membership, the exclusivity of the
/// gift and tier field groups, the global-scope shape, bounds, and the identity/shape of children.
/// A Draft may be incomplete or business-invalid; the lifecycle service validates completeness and
/// economics at Publish / re-enable / Scheduled material edit.
///
/// `revision` is the campaign's own economic revision (bumped by the lifecycle service on edits that
/// change economics); it is what a frozen scope snapshot and a signed quote pin themselves to.
model GiftQuantityCampaign {
  id         String                   @id @default(cuid())
  kind       GiftQuantityCampaignKind
  name       String
  startsAt   DateTime?
  endsAt     DateTime?
  isEnabled  Boolean                  @default(false)
  enabledAt  DateTime?
  disabledAt DateTime?
  revision   Int                      @default(1)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  /// Stack priority: lower runs first. Unique among campaigns acting on the same unit price is a
  /// publish-time rule, not a column constraint (legacy campaigns have no priority).
  stackPriority   Int?
  stackingEnabled Boolean @default(false)

  scopeMode              GiftQuantityScopeMode @default(DYNAMIC_CATEGORY)
  categoryKeys           String[]              @default([])
  /// Fixed scope audit: when the product set was frozen and at which campaign revision. Both null
  /// or both set; the frozen ids live in `GiftQuantityFrozenProduct`.
  frozenAt               DateTime?
  frozenCampaignRevision Int?

  // GIFT_ITEM rule
  giftTrigger         GiftTrigger?
  minimumQuantity     Int?
  minimumSubtotalVnd  BigInt?
  subtotalScope       GiftSubtotalScope?
  awardMode           GiftAwardMode?
  maxGiftsPerOrder    Int?
  allowDuplicateGifts Boolean?

  // QUANTITY_TIER rule. One unit for the whole campaign: methods are never mixed.
  tierUnit              QuantityTierDiscountUnit?
  tierDiscountedUnits   QuantityTierDiscountedUnits?
  tierSelectionPriority QuantityTierSelectionPriority?

  targets     GiftQuantityTarget[]
  frozen      GiftQuantityFrozenProduct[]
  tiers       QuantityTier[]
  giftOptions GiftOption[]
  stackPeers  GiftQuantityStackPeer[]
  cartGiftSelections CartGiftSelection[]

  @@unique([id, kind])
  @@unique([id, kind, tierUnit])
  @@index([isEnabled, startsAt, endsAt])
}

/// Explicit product include / exclude entries. Exclude always wins at evaluation; a product may be
/// listed once per campaign, so an include and an exclude of the same product cannot coexist.
model GiftQuantityTarget {
  id         String                      @id @default(cuid())
  campaignId String
  productId  String
  role       GiftQuantityScopeTargetRole
  createdAt  DateTime                    @default(now())
  campaign   GiftQuantityCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    ProductMirror               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
}

/// The frozen product set of a FIXED_PRODUCT_SET campaign. Written only inside the transaction that
/// publishes / re-enables / edits the scope of a campaign, never at its start time.
model GiftQuantityFrozenProduct {
  campaignId String
  productId  String
  campaign   GiftQuantityCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    ProductMirror        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
}

/// A quantity tier. `campaignKind` is fixed to QUANTITY_TIER and part of the foreign key, so a tier
/// can only ever hang off a QUANTITY_TIER campaign.
model QuantityTier {
  id            String                   @id @default(cuid())
  campaignId    String
  campaignKind  GiftQuantityCampaignKind @default(QUANTITY_TIER)
  /// Copy of the parent's `tierUnit`, held in step by an `ON UPDATE CASCADE` composite foreign key.
  /// It exists so the database itself can bound a percentage tier to 1..99; a tier can therefore
  /// only be written once the campaign has chosen its unit, and the unit cannot be switched to
  /// `PERCENTAGE` while any tier holds a value above 99.
  unit          QuantityTierDiscountUnit
  minQuantity   Int
  /// Percent (1..99) or VND per discounted unit, per `unit`.
  discountValue Int
  createdAt     DateTime                 @default(now())
  campaign      GiftQuantityCampaign     @relation(fields: [campaignId, campaignKind, unit], references: [id, kind, tierUnit], onDelete: Cascade, onUpdate: Cascade)

  @@unique([campaignId, minQuantity])
}

/// One variant a gift campaign may give. Same shape rule as `QuantityTier`: GIFT_ITEM campaigns only.
model GiftOption {
  id           String                   @id @default(cuid())
  campaignId   String
  campaignKind GiftQuantityCampaignKind @default(GIFT_ITEM)
  variantId    String
  createdAt    DateTime                 @default(now())
  campaign     GiftQuantityCampaign     @relation(fields: [campaignId, campaignKind], references: [id, kind], onDelete: Cascade)
  variant      VariantMirror            @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, variantId])
  @@index([variantId])
}

/// A stack permission this campaign grants. `peerCampaignId = "*"` means every campaign of that kind.
model GiftQuantityStackPeer {
  id             String                    @id @default(cuid())
  campaignId     String
  peerKind       GiftQuantityStackPeerKind
  peerCampaignId String
  createdAt      DateTime                  @default(now())
  campaign       GiftQuantityCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, peerKind, peerCampaignId])
}

/// A legacy campaign's consent to stack with quantity-tier campaigns (ADR 0016 D-10), written by the
/// gift/quantity admin write contract. Absent row = not stackable = legacy behaviour unchanged. It
/// lives in its own table so the legacy `PromotionCampaign` table, its constraints and every legacy
/// reader stay exactly as they are.
model LegacyPromotionStackConsent {
  campaignId    String            @id
  /// Position in the stack: lower runs first. Must be unique among enabled stacking campaigns.
  stackPriority Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  campaign      PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/// A buyer's chosen gift for a cart (GQ11). Kept apart from `CartItem` on purpose: a gift is never a
/// paid line, so it can neither satisfy a paid-quantity threshold nor share the paid
/// `(cartId, variantId)` uniqueness -- the same variant can be bought *and* received as a gift.
///
/// It records a choice only. It stores no price and grants no entitlement: what the buyer is owed is
/// recomputed from the live cart and campaign every time. `campaignRevision` is the campaign revision
/// the buyer saw; a later revision marks the choice stale for the buyer to re-confirm, it is never
/// silently repaired. Deleted with the cart only: a hard delete of the chosen variant or campaign is
/// RESTRICTed (FR-06: a gift choice is never erased silently); sync soft-deletes, campaigns are disabled.
model CartGiftSelection {
  id               String                   @id @default(cuid())
  cartId           String
  campaignId       String
  /// Always `GIFT_ITEM`; part of the composite key so a tier campaign can never be referenced.
  campaignKind     GiftQuantityCampaignKind @default(GIFT_ITEM)
  variantId        String
  quantity         Int
  campaignRevision Int
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  cart             Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  campaign         GiftQuantityCampaign     @relation(fields: [campaignId, campaignKind], references: [id, kind], onDelete: Restrict)
  variant          VariantMirror            @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, campaignId, variantId])
  @@index([campaignId])
  @@index([variantId])
}

model VariantMirror {
  id                              String                     @id @default(cuid())
  pancakeVariationId              String                     @unique
  productId                       String
  pancakeDisplayId                String?
  pancakeBarcode                  String?
  pancakeFields                   Json?
  pancakeImageUrls                Json?
  pancakeIsHidden                 Boolean?
  pancakeIsLocked                 Boolean?
  pancakeRetailPrice              Float?
  pancakeRetailPriceAfterDiscount Float?
  sku                             String?
  color                           String?
  size                            String?
  isPresent                       Boolean                    @default(true)
  isActive                        Boolean                    @default(true)
  syncedAt                        DateTime
  /// Start of the Pancake stock read that last wrote this variant's warehouse set, even an empty
  /// one. A read that began earlier never overwrites it (newer read wins, ADR 0014 §4.1).
  stockObservedAt                 DateTime?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  product                         ProductMirror              @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseStocks                 WarehouseStock[]
  cartItems                       CartItem[]
  compositeComponents             CompositeComponentMirror[] @relation("CompositeParent")
  compositeParents                CompositeComponentMirror[] @relation("CompositeComponent")
  promotionTargets                PromotionTarget[]
  giftOptions                     GiftOption[]
  cartGiftSelections              CartGiftSelection[]
  capacityReservations            VariantCapacityReservation[]
  capacityReservationResources    CapacityReservationResource[]
  availabilityCycle               VariantAvailabilityCycle?

  @@index([productId])
  @@index([sku])
  @@index([isPresent])
}

model CompositeComponentMirror {
  parentVariantId    String
  componentVariantId String
  quantity           Int
  syncedAt           DateTime
  parentVariant      VariantMirror @relation("CompositeParent", fields: [parentVariantId], references: [id], onDelete: Cascade)
  componentVariant   VariantMirror @relation("CompositeComponent", fields: [componentVariantId], references: [id], onDelete: Cascade)

  @@id([parentVariantId, componentVariantId])
  @@index([componentVariantId])
}

model WarehouseStock {
  id                 String        @id @default(cuid())
  variantId          String
  pancakeWarehouseId String
  quantity           Float
  syncedAt           DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  variant            VariantMirror @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, pancakeWarehouseId])
  @@index([pancakeWarehouseId])
}

model CatalogSyncState {
  pancakeShopId Int      @id
  syncedAt      DateTime
  updatedAt     DateTime @updatedAt
}

/// A pending "this variation's stock in this warehouse changed" marker from a Pancake
/// `variations_warehouses` webhook. It is a trigger, never a quantity: the batch worker reads the
/// variation's authoritative stock from Pancake and writes it through the same guarded path as the
/// catalog sync. One row per (variation, warehouse), so duplicate and out-of-order deliveries collapse
/// into the latest marker; a row is deleted only once a read that began after `lastReceivedAt` has
/// been applied, and the hourly reconciliation covers any marker that never arrives.
model PancakeInventorySignal {
  pancakeVariationId String
  pancakeWarehouseId String
  receivedCount      Int      @default(1)
  firstReceivedAt    DateTime @default(now())
  lastReceivedAt     DateTime
  attempts           Int      @default(0)

  @@id([pancakeVariationId, pancakeWarehouseId])
  @@index([lastReceivedAt])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     CartItem[]
  giftSelections CartGiftSelection[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String        @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  // Public PDP validated by the committed add; independent of a component's owner.
  sourceProductSlug String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cart      Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   VariantMirror @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model OrderMirror {
  id                     String              @id @default(uuid())
  publicCode             String              @unique
  userId                 String?
  sourceCartId           String?
  pancakeShopId          Int?
  pancakeOrderId         String?             @unique
  pancakeSystemId        String?
  pancakeStatus          Int?
  pancakeStatusUpdatedAt String?
  state                  LocalOrderState     @default(DRAFT)
  syncErrorCode          String?
  checkoutSnapshottedAt  DateTime?
  /// Original accepted POS submission instant; reconciliation must not move conversion time.
  purchaseOccurredAt     DateTime?
  /// Server-only attribution and immutable serialized event for reconciliation/replay.
  metaPurchaseContext    String?
  metaPurchasePayload    String?
  metaPurchaseSentAt     DateTime?
  guestName              String?
  guestPhone             String?
  provinceRef            String?
  districtRef            String?
  communeRef             String?
  addressDetail          String?
  note                   String?
  merchandiseSubtotalVnd BigInt?
  shippingFeeVnd         BigInt?
  totalVnd               BigInt?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines                  OrderLineSnapshot[]
  capacityReservations   VariantCapacityReservation[]
  preorderSnapshot       OrderPreorderSnapshot?

  @@index([userId, createdAt])
  @@index([sourceCartId])
  @@index([state, createdAt])
}

/// The immutable finalized line. Every promotion column is additive and nullable so historical rows
/// stay valid and an application rollback is not blocked by a column older code never writes.
///
/// `unitPriceVnd` remains the final customer price; `baseUnitPriceVnd` records what it would have
/// been without a promotion. The promotion facts are a snapshot, not a foreign key: finalized order
/// history must never be rewritten by anything that later happens to a campaign row.
model OrderLineSnapshot {
  id                       String                 @id @default(cuid())
  orderId                  String
  variantId                String
  pancakeVariationId       String
  /// Frozen existing Meta slug identity. Null means historical identity is not known.
  metaContentId            String?
  productName              String
  color                    String?
  size                     String
  quantity                 Int
  unitPriceVnd             BigInt
  lineTotalVnd             BigInt
  baseUnitPriceVnd         BigInt?
  promotionCampaignId      String?
  promotionName            String?
  promotionKind            PromotionCampaignKind?
  promotionDiscountType    PromotionDiscountType?
  promotionPercentageValue Int?
  promotionFixedPriceVnd   BigInt?
  createdAt                DateTime               @default(now())
  order                    OrderMirror            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// I7 — immutable order-level preorder facts captured exactly when the order becomes CONFIRMED.
///
/// This is deliberately separate from the mutable DRAFT quote snapshot. Once created, the database
/// migration protects both this row and its line rows from UPDATE/DELETE, and the order relation is
/// RESTRICT, so historical preorder truth cannot be rewritten or silently removed by later policy,
/// stock, or order cleanup.
model OrderPreorderSnapshot {
  id               String                       @id @default(cuid())
  orderId          String                       @unique
  confirmedAt      DateTime
  preorderReadyAt             DateTime?
  shippingInnerCityMinDays     Int?
  shippingInnerCityMaxDays     Int?
  shippingOtherProvinceMinDays Int?
  shippingOtherProvinceMaxDays Int?
  createdAt                   DateTime                     @default(now())
  order            OrderMirror                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines            OrderPreorderLineSnapshot[]

  @@index([preorderReadyAt])
}

/// I7 — one immutable line-level preorder/ready state from the confirmation boundary.
model OrderPreorderLineSnapshot {
  id          String                  @id @default(cuid())
  snapshotId  String
  variantId   String
  quantity    Int
  state       OrderPreorderLineState
  preorderReadyAt DateTime?
  createdAt   DateTime                @default(now())
  snapshot    OrderPreorderSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([snapshotId, variantId])
  @@index([variantId])
}

model SyncEvent {
  id         String          @id @default(cuid())
  kind       String
  externalId String?
  status     SyncEventStatus @default(PENDING)
  errorCode  String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([kind, status])
  @@index([externalId])
}

// ---------------------------------------------------------------------------
// Website-owned merchandising (ADR 0013). Owner-approved 2026-09-16, five
// additive models. Category *identity* stays in `src/brand/category.config.ts`
// — a row cannot create an App Router route, so persisting the taxonomy would
// only create a second authority free to disagree with the routes. What lives
// here is membership and ordering, which are data.
// ---------------------------------------------------------------------------

/// The homepage Featured section (ADR 0013 §3, master spec §20).
///
/// Deliberately global: the approved homepage has exactly one Featured section, so a fake parent
/// collection would add an owner that does not exist in product truth. `position` is unique, so two
/// products cannot claim the same slot. An empty table means the section is empty — it must never
/// fall back to newest/bestseller logic.
model HomepageFeaturedProduct {
  productId String @id
  position  Int    @unique

  product ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Website-owned category assignment (ADR 0013 §4.5). One row per (product, assigned category).
///
/// Only the assigned node is stored. The top-level tree is derived through the taxonomy and never
/// persisted, which is what keeps a re-parenting out of the schema. Top-level exclusivity is
/// enforced at the admin write boundary and audited by `findCategoryMembershipViolations()`; the
/// database cannot enforce it without a second copy of the taxonomy in SQL.
model ProductCategoryMembership {
  productId   String
  categoryKey String
  createdAt   DateTime @default(now())

  product ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryKey])
  @@index([categoryKey])
}

/// Merchandised order for one category's PLP (ADR 0013 §5).
///
/// Keyed by `categoryKey` rather than by a membership row, so a parent PLP can rank the union it
/// lists: a product inherited into `/ao-dai` has no membership row for `aoDai` to carry a position.
/// Separate from membership on purpose — merging them would make an unranked product
/// indistinguishable from an unassigned one.
model CategoryProductOrder {
  categoryKey String
  productId   String
  position    Int

  product ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryKey, productId])
  @@unique([categoryKey, position])
}

/// Category editorial and mega-menu media (ADR 0013 §6, master spec §21 and §24).
///
/// Two explicit fields because the two surfaces have distinct crops. `CollectionDefinition`
/// media is not reused: that would assert a collection ↔ category identity that does not exist.
/// `null` means no editorial image, and the UI uses its approved no-image behaviour.
model CategoryEditorialMedia {
  categoryKey      String   @id
  heroImageUrl     String?
  megaMenuImageUrl String?
  updatedAt        DateTime @updatedAt
}

/// Size-guide artwork shown in the product page's size-guide dialog, one row per approved guide id
/// (`src/brand/size-guide.config.ts`). Website-owned and set in admin; an absent row means no
/// artwork, and the dialog draws the guide's table from its configured data instead.
model SizeGuideMedia {
  guideId   String   @id
  imageUrl  String
  updatedAt DateTime @updatedAt
}

/// Manual related-product override — stage 1 of ADR 0013 §7.
///
/// Stages 2–4 need no storage: they are queries over `ProductCategoryMembership`. Self-reference is
/// rejected at the admin boundary *and* by a database CHECK, because it is intra-row and therefore
/// something the database genuinely can enforce.
model RelatedProductOverride {
  productId        String
  relatedProductId String
  position         Int

  product ProductMirror @relation("RelatedSource", fields: [productId], references: [id], onDelete: Cascade)
  related ProductMirror @relation("RelatedTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@unique([productId, position])
  @@index([relatedProductId])
}

// ---------------------------------------------------------------------------
// Atomic capacity (ADR 0014 §13). Owner-authorized 2026-09-17, after the design
// review that returned four corrections — all of which are in the shapes below.
// Additive, and NO BACKFILL: a product with no policy row resolves to STANDARD
// at −20 through `resolveSellingPolicy()`, which is the one producer of that
// answer. A column default would not supply it, because the row does not exist.
// ---------------------------------------------------------------------------

/// Website-owned selling policy for one product (ADR 0014 §5, master spec §27).
///
/// Separate from `ProductMirror` on purpose, following the `ProductMerchantFacts` pattern: this is
/// website-owned truth and Pancake catalog sync must never overwrite it. Absence is not "unknown" —
/// it means the approved default, resolved in exactly one place.
model ProductSellingPolicy {
  productId          String      @id
  sellingMode        SellingMode @default(STANDARD)
  negativeStockLimit Int         @default(-20)
  updatedAt          DateTime    @updatedAt

  product ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// The capacity ledger — one row per (order, variant) (ADR 0014 §13).
///
/// `onDelete: Restrict` on **both** relations is deliberate. This is ledger and audit state, not a
/// child collection: cascading it away with a hard-deleted order would silently free capacity that
/// is still counting — an `UNKNOWN` hold above all, which §8 says only reconciliation may release —
/// through a path nobody reviewed. §15 already prohibits that outcome when it rules out dropping the
/// ledger as a rollback. `Restrict` makes such a delete fail loudly instead.
///
/// §6.2 additionally depends on `VariantMirror` existing for every reservable variant, because that
/// row is the lock target that closes the empty-ledger race.
model VariantCapacityReservation {
  id          String           @id @default(cuid())
  orderId     String
  variantId   String
  quantity              Int
  state                 ReservationState       @default(RESERVED)
  acceptedPreorderState OrderPreorderLineState?
  committedAt           DateTime?
  releasedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  order     OrderMirror                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant   VariantMirror                  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  resources CapacityReservationResource[]

  @@unique([orderId, variantId])
  @@index([variantId, state])
  @@index([state, updatedAt])
}

/// Immutable resource snapshot for one line reservation.
///
/// A line reservation keeps the variant the buyer purchased. These rows keep the capacity resources
/// that line consumed at the reservation boundary. For a standalone line that is the same variant;
/// for a FULL SET it is each component variant multiplied by the composite edge quantity. Snapshotting
/// this mapping prevents a later catalog graph change from moving an existing hold to different stock.
///
/// `mirroredAt` is the durable mirror handoff (ADR 0014 §4.1): the instant a catalog sync proved that
/// this resource's consumption is included in mirrored `WarehouseStock`, because the stock
/// observation for the variant began (`mirrorObservationStartedAt`) strictly after the line was
/// `COMMITTED`. From then on the mirror owns the units and the resource stops holding; until then a
/// `COMMITTED` resource keeps holding. Written once, only by `handOffMirroredCapacity()` inside the
/// catalog sync transaction, and never cleared.
model CapacityReservationResource {
  id                         String                     @id @default(cuid())
  reservationId              String
  variantId                  String
  quantity                   Int
  mirroredAt                 DateTime?
  mirrorObservationStartedAt DateTime?
  reservation                VariantCapacityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variant                    VariantMirror              @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([reservationId, variantId], map: "CapacityReservationResource_reservation_variant_key")
  @@index([variantId], map: "CapacityReservationResource_variant_idx")
  @@index([variantId, mirroredAt], map: "CapacityReservationResource_variant_mirrored_idx")
}

/// I9 — one preorder availability cycle per variant (ADR 0011, owner-approved 2026-09-18).
///
/// ADR 0011 blocked Google's `backorder` row because no truthful availability date existed, and
/// named the fabrications it would not accept: a rolling `today + 15`, and an order ETA. The owner
/// approved an automatic per-variant cycle instead, and this table is its canonical owner — the one
/// place the date lives, so Merchant output and JSON-LD read the same fact rather than each
/// deriving one.
///
/// Exactly one row per variant, holding the CURRENT cycle rather than a history. A cycle ends when
/// ready stock returns or the product leaves preorder, and the next sold-out observation opens a
/// new one, so past cycles have no consumer and storing them would only invite a reader to pick the
/// wrong one.
///
/// `lastStockNonPositive` and `lastPreorder` are the previous trusted observation. They are what
/// makes an edge detectable at all: without them a re-sync could not tell "still sold out" from
/// "just sold out", and the date would move every time the catalog ran.
model VariantAvailabilityCycle {
  variantId String @id

  /// The Vietnam (UTC+7) calendar day this cycle opened. Null exactly when no cycle is open.
  cycleStartDate DateTime? @db.Date
  /// `cycleStartDate` + 15 calendar days, fixed when the cycle opens and never recomputed.
  availabilityDate DateTime? @db.Date

  lastStockNonPositive Boolean
  lastPreorder         Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade, unlike the capacity ledger's `Restrict`: a cycle is derived observation state that
  /// holds no capacity, so deleting it with its variant frees nothing and hides nothing.
  variant VariantMirror @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([availabilityDate])
}
