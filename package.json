{
  "name": "la-na-design",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "bootstrap:brand": "node --experimental-strip-types scripts/bootstrap-brand.ts",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types --test tests/domain/*.test.ts",
    "test": "node --experimental-strip-types --test tests/domain/*.test.ts tests/integrations/*.test.ts",
    "test:db": "node --experimental-strip-types --test --test-concurrency=1 tests/database/*.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "release:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/release-readiness.ts",
    "money:audit": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/mirrored-money-audit.ts",
    "sitemap:capacity:audit": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sitemap-capacity-audit.ts",
    "merchant:identity:audit": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/merchant-identity-audit.ts",
    "merchant:durability:evidence": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-durability-evidence.ts",
    "merchant:m1:experiment": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-m1-durability-experiment.ts",
    "pancake:contract:discover": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-contract-discover.ts",
    "pancake:contract:verify": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-contract-shape.ts",
    "pancake:catalog:audit": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-catalog-audit.ts",
    "pancake:composite:discover": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-composite-discover.ts",
    "pancake:composite:invariants": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-composite-invariants.ts",
    "pancake:catalog:accept": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/p17-live-catalog-acceptance.ts",
    "pancake:stock:probe": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-stock-probe.ts",
    "pancake:order:inspect-openapi": "node --experimental-strip-types scripts/pancake-order-openapi-inspect.ts",
    "pancake:order-status:inspect-openapi": "node --experimental-strip-types scripts/pancake-order-status-openapi-inspect.ts",
    "pancake:geo:inspect-openapi": "node --experimental-strip-types scripts/pancake-geo-openapi-inspect.ts",
    "pancake:price:accept": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-p10-custom-price-acceptance.ts",
    "pancake:t7:accept": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-t7-confirmed-purchase-acceptance.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.25",
    "dotenv": "17.4.2",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
