{
	# This VPS is shared. nginx-proxy-manager (NPM) is the public TLS edge and
	# forwards plain HTTP to Caddy over a host-owned external Docker network.
	# Trust only the configured NPM network and parse X-Forwarded-For from
	# right-to-left because NPM appends the connecting address to that header.
	# Compose requires the reviewed NPM trust range before Caddy can start.
	servers {
		trusted_proxies static {$EDGE_TRUSTED_PROXY_CIDR}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip
	log

	# ADR 0010: the bare apex is not a storefront host. Send it to the server-owned
	# APP_DOMAIN before the app sees it, so browsers never submit Server Actions from an
	# apex Origin against a www X-Forwarded-Host (Next.js rejects that mismatch as
	# "Invalid Server Actions request"). The X-Forwarded-Host test covers an edge that
	# rewrites Host; a spoofed value can only cause a redirect to APP_DOMAIN.
	@apex expression {http.request.host} == "{$APEX_REDIRECT_DOMAIN}" || {http.request.header.X-Forwarded-Host} == "{$APEX_REDIRECT_DOMAIN}"
	redir @apex https://{$APP_DOMAIN}{uri} 308

	reverse_proxy app:3000 {
		# Always overwrite the application-owned client-IP header. {client_ip}
		# is derived only from the trusted NPM hop configured above.
		header_up X-LA-Client-IP {client_ip}
		health_uri /shop
		health_interval 30s
		health_timeout 5s
	}
}
