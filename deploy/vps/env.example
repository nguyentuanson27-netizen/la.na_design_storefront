# Copy to deploy/vps/.env.production on the VPS and chmod 600.
# Never commit the real file.

# Exact approved application commit to build/promote.
RELEASE_SHA=replace-with-approved-git-sha

# Explicit release target. Required; do not infer production from a missing value.
# production -> project.config.json productionDomain
# temporary  -> la.lanadesign.vn (always noindex)
DEPLOY_TARGET=

# APP_DOMAIN and BETTER_AUTH_URL are NOT set here. deploy.sh derives them from DEPLOY_TARGET:
# production uses project.config.json; temporary uses the one approved legacy/noindex host.
# DNS/TLS/NPM/Caddy and the real VPS environment still require observed evidence before claiming
# either target is serving traffic.
BETTER_AUTH_SECRET=REPLACE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_IP_HEADER=x-la-client-ip

# Search exposure is fail-closed. Permanent-domain selection does NOT enable indexing.
# Keep false until Gate S verification and a separate explicit human indexing approval are complete.
SEARCH_INDEXING_ENABLED=false

# Database container inputs. POSTGRES_DB is NOT set here: deploy.sh exports it from
# project.config.json. DATABASE_URL stays here because it carries a password, and it is the one
# unavoidable copy of the database name -- release:check refuses to deploy when the database inside
# it does not match project.config.json. The host must stay `postgres` on the Compose network.
POSTGRES_USER=REPLACE_ME_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://REPLACE_ME_DATABASE_USER:REPLACE_ME_URL_ENCODED_PASSWORD@postgres:5432/REPLACE_ME_DATABASE_NAME

# Third-party integration.
PANCAKE_API_KEY=replace-me
PANCAKE_SHOP_ID=replace-me

# Contact form delivery. Server-only; never expose this value to the client.
# Before public acceptance, verify lanadesign.vn in Resend and confirm website@lanadesign.vn can send.
RESEND_API_KEY=

# The LA_ prefix on the variables below is historical, not a brand marker: it stays the same in
# every fork of this template.
#
# Reviewed server-owned Merchant market authority (O2). These values let the feed describe the
# approved Vietnam / vi / VND market; they do not configure Merchant Center, Scheduled Fetch,
# listings, Ads linkage, GTM, search indexing, or promotion activation.
LA_MERCHANT_TARGET_COUNTRY=VN
LA_MERCHANT_CONTENT_LANGUAGE=vi
LA_MERCHANT_CURRENCY=VND

# Server-owned shipping policy.
LA_SHIPPING_FEE_VND=30000
LA_FREE_SHIPPING_SUBTOTAL_VND=1000000
LA_FREE_SHIPPING_MIN_QUANTITY=3

# Meta (Facebook) tracking. Leave both blank to ship no tracking and keep the Content-Security
# Policy closed around Facebook's origins.
# The pixel id is consumed at image BUILD time: compose passes it through as a build arg, which it
# interpolates from this file, so setting it here is enough. Changing it requires rebuilding the
# image, because the CSP that admits Facebook's origins is baked into the build.
# The Conversions API token is an ordinary runtime secret.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_CAPI_ACCESS_TOKEN=

# Public-edge boundary. Both are required so a missing NPM network/trust range fails closed.
EDGE_NETWORK_NAME=
EDGE_TRUSTED_PROXY_CIDR=

# Record/pin reviewed image references before go-live. Digests are preferred on the real VPS.
POSTGRES_IMAGE=postgres:16-bookworm
CADDY_IMAGE=caddy:2-alpine
