# Server-only secrets. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/la_clothing"

# Server-owned storefront origin host. Public deployments use HTTPS automatically;
# localhost/127.0.0.1 may use an explicit port for local HTTP development.
APP_DOMAIN="localhost:3000"

# Search exposure is fail-closed. Keep false on local/staging and until the
# dedicated LA Clothing production domain passes the explicit launch gate.
SEARCH_INDEXING_ENABLED="false"

# Better Auth: generate a high-entropy secret with at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Required for non-local deployments. Set this only to a single-value client-IP
# header that your edge/proxy overwrites and end users cannot spoof directly.
# Example for a suitably configured proxy/CDN: cf-connecting-ip, x-vercel-forwarded-for, etc.
# BETTER_AUTH_IP_HEADER="replace-with-your-trusted-client-ip-header"

PANCAKE_API_KEY="replace-me"
PANCAKE_SHOP_ID="replace-me"
# Optional: Pancake POS order source ("Nguồn đơn") ID that tags storefront orders.
# Before setting this in production, confirm with one authorized test order that Pancake accepts the
# ID for PANCAKE_SHOP_ID and shows it as the order source; a refused create makes checkout REJECTED.
# Leave blank until verified, then set it explicitly in the protected production env (e.g. 922027175).
PANCAKE_ORDER_SOURCE_ID=
# Optional (Gift & Quantity Promotions): comma-separated Pancake shop ids whose POS accepted several
# lines of one variation at different unit prices in the controlled GQ01 acceptance run
# (docs/integrations/pancake-gift-quantity-acceptance.md). Orders with gifts or quantity-tier segments
# are sent only for a listed shop; for any other shop nothing is sent to POS and the order is closed
# REJECTED / BENEFIT_SUBMISSION_UNAVAILABLE (its signed quote is kept as history; a closed order never
# returns to DRAFT, so the buyer's next attempt creates a new order). Leave blank until an operator has
# recorded that run for the shop.
LA_PANCAKE_LINE_LEVEL_PRICING_VERIFIED_SHOP_IDS=

# Contact form delivery — server-only Resend API key.
RESEND_API_KEY="replace-me"

# Server-owned base shipping fee; omit LA_SHIPPING_FEE_VND for the 30,000 VND default.
# Values must be canonical non-negative base-10 integers.
# Free shipping is managed by campaigns at /admin/promotions/shipping.
# Without an active, applicable campaign, checkout charges the base fee.
# Legacy LA_FREE_SHIPPING_* variables are ignored; remove them from existing environments.
# LA_SHIPPING_FEE_VND="30000"

# Desired tracking mode: disabled | preview | live. Server-owned on purpose — a NEXT_PUBLIC_ value
# or any request input must never be able to promote a deployment to live. Omit for the fail-closed
# default of "disabled", which renders no dataLayer bootstrap and no page-view events at all.
#
# Google Tag Manager is NOT loaded in any mode yet: preview and live currently establish the
# first-party dataLayer, tracking mode and consent defaults only. The first actual GTM loader and
# the CSP origins it needs arrive with the unit that reviews an exact saved container version.
# LA_TRACKING_MODE="disabled"
# Required when LA_TRACKING_MODE is preview or live, rejected when it is disabled. Configuration
# identifier, not a secret.
# LA_GTM_CONTAINER_ID="GTM-XXXXXXX"

# Meta (Facebook) pixel — leave unset to ship no tracking at all.
# The 15-16 digit pixel id from Events Manager. Without it no script loads and the Content-Security
# Policy stays closed around Facebook's origins.
# This one is read at BUILD time: the CSP is assembled from it and baked into the build, so setting
# it only at runtime would render a script the policy then blocks. Rebuild after changing it.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
# Direct Conversions API: browser-triggered PageView/ViewContent/InitiateCheckout, committed
# AddToCart, and confirmed Purchase. Purchase dedup uses publicCode; other twins share a UUID.
# Needs the build-time pixel id above. Secret: never expose it to a client or dataLayer.
FACEBOOK_CAPI_ACCESS_TOKEN=""
# Optional. Pins the Graph API version; confirm against Events Manager before changing.
FACEBOOK_GRAPH_API_VERSION="v26.0"
# Optional. Routes server events to Events Manager's Test Events tab instead of live reporting.
FACEBOOK_CAPI_TEST_EVENT_CODE=""
# Optional runtime switch, off unless exactly "true": server-written _fbc and la_vid cookies, and
# la_vid sent to Meta as external_id. Needs the build-time pixel id above.
LA_META_FIRST_PARTY_COOKIES_ENABLED=""

# Per-request script nonce CSP: report-only (default), enforce, or off. See deploy/vps/env.example.
LA_CSP_STRICT_SCRIPTS=""

# ChatGPT Ads Measurement Pixel + Conversions API. Leave both blank to ship no OpenAI Ads
# measurement. The Pixel ID is public build-time configuration because the CSP is baked into the
# build. The Conversions API key is a server-only secret and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID=""
OPENAI_CONVERSIONS_API_KEY=""

# Zalo Ads Pixel — the id= value from Zalo Ads → Thư viện → Conversion → Lấy mã pixel. Public (not
# secret) build-time configuration, like the pixel ids above: the CSP is baked into the build, so
# changing it requires a rebuild. Blank ships no Zalo script and no Zalo origin in the CSP.
# Conversions are configured in the Zalo Ads dashboard; see docs/integrations/zalo-ads-pixel.md.
NEXT_PUBLIC_ZALO_ADS_PIXEL_ID=""

# Virtual try-on. Server-only: none of these may ever be NEXT_PUBLIC_.
# Off unless LA_TRY_ON_ENABLED is exactly "true"; missing config hides the PDP action.
LA_TRY_ON_ENABLED="false"
# Provider: vertex (backward-compatible default) | flow.
LA_TRY_ON_PROVIDER="vertex"

# Vertex rollback provider (Nano Banana Pro / gemini-3-pro-image, location global only).
# LA_TRY_ON_GCP_PROJECT_ID="your-gcp-project-id"
# Standard Application Default Credentials: path to the runtime service-account credential file.
# Never commit it. Grant only the Vertex AI permissions needed for online prediction.
# GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/google-credentials.json"

# Google Flow provider. The app talks only to the private Compose worker.
# LA_TRY_ON_FLOW_URL="http://flow-worker:8787"
# High-entropy shared bearer token; server-only, never commit the real value.
# LA_TRY_ON_FLOW_TOKEN="replace-with-at-least-32-random-characters"
# Persistent gflow Chrome profile name mounted only into flow-worker.
# LA_TRY_ON_FLOW_PROFILE="default"
# Optional dedicated existing Flow project; omitting it makes the worker create one "LA try-on"
# project once and reuse it.
# LA_TRY_ON_FLOW_PROJECT_ID=""
# Nano Banana 2.1's captured ogiZ0b model key; empty keeps the Pro -> 2.1 fallback disabled.
# LA_TRY_ON_FLOW_NANO_BANANA_2_1_MODEL_KEY=""
# Vertex overflow behind Flow: Vertex serves a request instead of Flow only when Flow is busy or
# marked down, never both for one request. Needs the Vertex settings above and a daily cap.
# LA_TRY_ON_OVERFLOW_PROVIDER="vertex"
# LA_TRY_ON_VERTEX_DAILY_CAP="40"

# Disk cache for encoded PDP photographs (/api/product-image). On only in production builds; "off"
# disables it. Default directory .next/cache/product-images, default budget 2048 MB.
# PRODUCT_IMAGE_CACHE_DIR=""
# PRODUCT_IMAGE_CACHE_MAX_MB="2048"

# Checkout-only Smart Promotion Upsell (SPEC-UPS-001). Both flags and verified POS are required.
# Keep OFF until the cart paid-revision migration, staging checkout and POS gates are accepted.
LA_GIFT_QUANTITY_PROMOTIONS_ENABLED=false
LA_PROMOTION_UPSELL_ENABLED=false
